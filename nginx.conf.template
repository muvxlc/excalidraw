server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Same-origin AI requests avoid the router's missing CORS headers.
  location /api/ai/ {
    proxy_pass __AI_UPSTREAM__/;
    include /etc/nginx/conf.d/ai-auth.conf;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host router.bangkhan.com;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    chunked_transfer_encoding on;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
